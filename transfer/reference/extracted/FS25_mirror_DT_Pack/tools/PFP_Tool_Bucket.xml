	<storeData>
        <name>
            <en>Bucket for PFP-1.2</en>
			<de>Schöpfkelle für PFP-1.2</de>
			<ru>Ковш для ПФП-1.2</ru>
		</name>
		<specs>
            <workingWidth>3.0</workingWidth>
		    <combination xmlFilename="tools/PFP_12.xml"/>
        </specs>
        <functions>
            <function>$l10n_function_leveler</function>
        </functions>
        <image>store/storePFPBucket.dds</image>
        <price>2000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>VGTZ</brand>
        <category>vgtz</category>
    <shopTranslationOffset>0 0.2 0</shopTranslationOffset>
    <shopRotationOffset>0.25 0 0</shopRotationOffset>
    </storeData>
    
	<base>
       <typeDesc>$l10n_typeDesc_leveler</typeDesc>
        <filename>tools/PFP_Tool_Bucket.i3d</filename>
        <size width="2.8" length="1"/>
        <components>
            <component centerOfMass="0 0 0" solverIterationCount="10" mass="350"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT" />
        <mapHotspot type="TOOL" />
    </base>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacher" jointType="frontloader" topReferenceNode="torReferenceNode"/>
        </inputAttacherJoints>	
		<support animationName="moveSupport" /> 
    </attachable>

    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration>
                <fillUnits>
                    <fillUnit shopDisplayUnit="LITER" fillTypeCategories="SHOVEL" capacity="2000" >
                        <exactFillRootNode node="exactFillRootNode" />
                    </fillUnit>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypeCategories="SHOVEL" capacity="2000" showInShop="false" showOnHud="false"/>
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <fillVolume>
        <fillVolumeConfigurations>
            <fillVolumeConfiguration>
                <volumes>
                    <volume node="fillVolume" maxAllowedHeapAngle="30" fillUnitIndex="1" maxSubDivEdgeLength="0.6" />
                </volumes>
            </fillVolumeConfiguration>
        </fillVolumeConfigurations>

        <loadInfos>
            <loadInfo>
                <node node="fillVolumeLoadNode" width="2.0" length="0.1" />
            </loadInfo>
        </loadInfos>

        <unloadInfos>
            <unloadInfo>
                <node node="fillVolumeUnloadNode" width="2.0" length="0.1" />
            </unloadInfo>
        </unloadInfos>
    </fillVolume>

    <dischargeable requiresTipOcclusionArea="false">
        <dischargeNode node="dischargeNode" fillUnitIndex="1" emptySpeed="1000" >
            <raycast node="dischargeNode" maxDistance="30" useWorldNegYDirection="true" yOffset="2"/>
            <info width="2.0" length="1" zOffset="0.5"/>

            <effects>
                <effectNode effectClass="TipEffect">
                    <effectNode effectNode="emitterShape" effectClass="ParticleEffect" materialType="unloadingParticle"/>
                    <effectNode effectNode="grainEffect" materialType="unloading" fadeTime="0.5" alignXAxisToWorldY="true" extraDistance="0.15"/>
                </effectNode>
                <effectNode effectNode="smokeEffect" materialType="unloadingSmoke" fadeTime="0.5" />
            </effects>
        </dischargeNode>
    </dischargeable>

    <shovel>
        <shovelNode node="shovelNode" fillUnitIndex="1" loadInfoIndex="1" width="2.04" length="0.5" needsMovement="true" maxPickupAngle="105"/>
        <dischargeInfo node="dischargeNode" minSpeedAngle="90" maxSpeedAngle="120" />
    </shovel>
    <leveler fillUnitIndex="2" maxFillLevelPerMS="30">
        <levelerNode node="levelerNode" width="2.04" zOffset="0.2" minDropWidth="1" maxDropWidth="3.7" minDropDirOffset="1" maxDropDirOffset="1.5" minFillLevel="0.85">
            <smoothing allowed="true" radius="0.5" overlap="1.7" direction="0"/>
        </levelerNode>

        <pickUpDirection>1</pickUpDirection>
    </leveler>

    <animations>
        <animation name="moveSupport">
            <part node="colPart01" startTime="0.00" endTime="0.1" startTrans="0 0.684 -0.227"  endTrans="0 0.075 -0.227" />
            <sound template="clackVar5" startTime="0.01" direction="0" volumeScale="0.7" pitchScale="2.8" linkNode="bucket"/>
        </animation>
    </animations>

    <attacherJointControl maxTiltAngle="25">       
		<control controlFunction="controlAttacherJointHeight" controlAxis="AXIS_FRONTLOADER_TOOL" invertControlAxis="false" mouseSpeedFactor="0.2" iconName="FRONTLOADER_ARM_ROTATE_TOOL" />
         <sounds>
            <hydraulic template="defaultHydraulicSound" linkNode="0>" />
        </sounds>
    </attacherJointControl>
	
	<ai>
        <agentAttachment width="2.04" height="1.1" length="1.0" lengthOffset="-0.4"/>
    </ai>	
	
