<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="leveler" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>

    <storeData>
        <name>
			<en>Snow wedge</en>
			<ru>Снеговой клин</ru>			
        </name>
        <functions>
            <function>$l10n_function_snowPlow</function>
        </functions>
        <storePacks>
            <storePack>STARTER_SNOW</storePack>
        </storePacks>		
    <specs>
      <combination xmlFilename="dt75_SMD_PD.xml"/>
      <combination xmlFilename="dt75_SMD_starter.xml"/>	  
    </specs>		
        <image>store/store_snowWedge.dds</image>
        <price>6000</price>
        <lifetime>600</lifetime>
        <rotation>0</rotation>
        <brand>VgTZ</brand>
        <category>winterEquipment</category>
        <shopHeight>3</shopHeight>
        <vertexBufferMemoryUsage>189696</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>53248</indexBufferMemoryUsage>
        <textureMemoryUsage>524288</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <typeDesc>$l10n_typeDesc_snowPlow</typeDesc>
        <filename>dt75_snowWedge.i3d</filename>
        <size width="3.5" length="5" height="1.5"/>
        <components>
            <component centerOfMass="0 0 -0.15" solverIterationCount="20" mass="1200"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT"/>
        <mapHotspot type="TOOL"/>
    </base>

	<attachable>
		<inputAttacherJoints>
			<inputAttacherJoint node="attacherJoint" jointType="jointDump" topReferenceNode="topReferenceNode" lowerRotLimitScale="0 0 0" upperRotLimitScale="0 0 0" upperRotationOffset="0" lowerTransLimitScale="0 0 0" upperTransLimitScale="0 0 0" needsLowering="true" isControllable="true">
				<distanceToGround lower="0.246" upper="0.952"/>					
			</inputAttacherJoint>
		</inputAttacherJoints>
		<support animationName="moveSupport"/>
				
	</attachable>
	
    <attacherJointControl maxTiltAngle="25" supportsDamping="false">
        <control controlFunction="controlAttacherJointHeight" controlAxis="AXIS_HYDRAULICATTACHER1" invertControlAxis="false" mouseSpeedFactor="0.3" iconName="IMPLEMENT_ATTACHER_TRANS" />
        <sounds>
            <hydraulic template="hydraulicClose01" linkNode="attacherJoint" volumeScale="10" pitchScale="0.8" fadeIn="0.1" fadeOut="0.1"/>
        </sounds>
    </attacherJointControl>



    <fillUnit>
        <fillUnitConfigurations>
            <fillUnitConfiguration name="$l10n_configuration_valueDefault">
                <fillUnits>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SNOW" capacity="6000" showInShop="false" showOnHud="false"/>
                    <fillUnit unitTextOverride="$l10n_unit_literShort" fillTypes="SNOW" capacity="6000" showInShop="false" showOnHud="false"/>																	
                </fillUnits>
            </fillUnitConfiguration>
        </fillUnitConfigurations>
    </fillUnit>

    <leveler maxFillLevelPerMS="25" ignoreFarmlandState="true">
        <levelerNode node="levelerNode01" fillUnitIndex="1" width="1.3"   zOffset="0.0" minDropWidth="1.3" maxDropWidth="1.5" minDropDirOffset="1.3" maxDropDirOffset="32" alignToWorldY="false"/>
        <levelerNode node="levelerNode02" fillUnitIndex="2" width="1.3"   zOffset="0.0" minDropWidth="1.3" maxDropWidth="1.5" minDropDirOffset="1.3" maxDropDirOffset="32" alignToWorldY="false"/>		
				
        <force node="dt75_snowWedge_main_component1" maxForce="30" direction="1" />
        <pickUpDirection>1</pickUpDirection>
        <effects>
            <effectNode effectNode="effectMeshL" effectClass="ShaderPlaneEffect" materialType="leveler" fadeTime="1" speed="10" />
            <effectNode effectClass="SnowPlowMotionPathEffect" effectType="SNOW_PIECES" linkNode="snowEffectNodeL" >
                <motionPathEffect textureFilename="$data/vehicles/samasz/jump320/snowArray.dds" numRows="13" rowLength="27" minFade="0.15" speedScale="2" shapeScale="5.0"/>
                <snowPlowEffect shaderPlane="effectMeshL" minScale="1 1 1" maxScale="1 1 1" scrollSpeed="-5"/>
            </effectNode>			
            <effectNode effectClass="SnowPlowMotionPathEffect" effectType="SNOW_DUST" linkNode="snowEffectNodeL">
                <motionPathEffect textureFilename="$data/vehicles/samasz/jump320/snowArray.dds" numRows="13" rowLength="27" minFade="0.15" speedScale="2"/>
            </effectNode>

            <effectNode effectNode="effectMeshR" effectClass="ShaderPlaneEffect" materialType="leveler" fadeTime="1" speed="10" />
            <effectNode effectClass="SnowPlowMotionPathEffect" effectType="SNOW_PIECES" linkNode="snowEffectNodeR">
                <motionPathEffect textureFilename="$data/vehicles/samasz/jump320/snowArray.dds" numRows="13" rowLength="27" minFade="0.15" speedScale="2" shapeScale="5.0"/>
                <snowPlowEffect shaderPlane="effectMeshR" minScale="1 1 1" maxScale="1 1 1" scrollSpeed="-5"/>
            </effectNode>			
            <effectNode effectClass="SnowPlowMotionPathEffect" effectType="SNOW_DUST" linkNode="snowEffectNodeR">
                <motionPathEffect textureFilename="$data/vehicles/samasz/jump320/snowArray.dds" numRows="13" rowLength="27" minFade="0.15" speedScale="2"/>
            </effectNode>	
			
        </effects>
    </leveler>

    <ai>
        <agentAttachment useSize="true"/>
    </ai>

    <foliageBending>
        <bendingNode minX="-1.3" maxX="1.3" minZ="-0.2" maxZ="0.22" yOffset="0.1"/>
        <bendingNode minX="-1.1" maxX="1.1" minZ="-2.86" maxZ="0.22" yOffset="0.1"/>
    </foliageBending>

    <baseColorConfigurations useDefaultColors="true" >
        <material materialSlotName="mainColor" materialTemplateUseColorOnly="true"/>
		<baseColorConfiguration color="1 0.2 0.05" isDefault="true"/>	
    </baseColorConfigurations>	
    <designColorConfigurations useDefaultColors="true" title="$l10n_configuration_fasteningBar">
        <material materialSlotName="designColor" materialTemplateUseColorOnly="true"/>
        <designColorConfiguration color="0.05 0.05 0.05" isDefault="true"/>		
    </designColorConfigurations>	
    <designColor2Configurations useDefaultColors="true" title="$l10n_configuration_knife">
        <material materialSlotName="designColor2" materialTemplateUseColorOnly="true"/>
        <designColor2Configuration color="0.05 0.05 0.05" isDefault="true"/>		
    </designColor2Configurations>	
	

    <designConfigurations title="$l10n_configuration_sticker" isYesNoOption="false">
        <designConfiguration name="$l10n_configuration_valueNo" price="0">
            <objectChange node="design1"	visibilityActive="false"  	visibilityInactive="true"/>		
            <objectChange node="design2"	visibilityActive="false"  	visibilityInactive="true"/>			
            <objectChange node="design3"	visibilityActive="false"  	visibilityInactive="true"/>	
            <objectChange node="design4"	visibilityActive="false"  	visibilityInactive="true"/>						
        </designConfiguration>
        <designConfiguration name="$l10n_configuration_option1" price="100">
            <objectChange node="design1"	visibilityActive="true"  	visibilityInactive="false"/>		
            <objectChange node="design2"	visibilityActive="false"  	visibilityInactive="true"/>			
            <objectChange node="design3"	visibilityActive="false"  	visibilityInactive="true"/>	
            <objectChange node="design4"	visibilityActive="false"  	visibilityInactive="true"/>		
        </designConfiguration>
        <designConfiguration name="$l10n_configuration_option2" price="100">
            <objectChange node="design1"	visibilityActive="false"  	visibilityInactive="true"/>		
            <objectChange node="design2"	visibilityActive="true"  	visibilityInactive="false"/>				
            <objectChange node="design3"	visibilityActive="false"  	visibilityInactive="true"/>	
            <objectChange node="design4"	visibilityActive="false"  	visibilityInactive="true"/>		
        </designConfiguration>	
        <designConfiguration name="$l10n_configuration_option3" price="100">
            <objectChange node="design1"	visibilityActive="false"  	visibilityInactive="true"/>		
            <objectChange node="design2"	visibilityActive="false"  	visibilityInactive="true"/>			
            <objectChange node="design3"	visibilityActive="true"  	visibilityInactive="false"/>		
            <objectChange node="design4"	visibilityActive="false"  	visibilityInactive="true"/>		
        </designConfiguration>
        <designConfiguration name="$l10n_configuration_option4" price="100">
            <objectChange node="design1"	visibilityActive="false"  	visibilityInactive="true"/>		
            <objectChange node="design2"	visibilityActive="false"  	visibilityInactive="true"/>			
            <objectChange node="design3"	visibilityActive="false"  	visibilityInactive="true"/>	
            <objectChange node="design4"	visibilityActive="true"  	visibilityInactive="false"/>			
        </designConfiguration>			
    </designConfigurations>	

    <wearable wearDuration="520" workMultiplier="5" fieldMultiplier="2"/>
    <washable dirtDuration="90" washDuration="1" workMultiplier="6" fieldMultiplier="2"/>

    <i3dMappings>
        <i3dMapping id="dt75_snowWedge_main_component1" node="0>" />
        <i3dMapping id="snowWedgeVis" node="0>0|0" />
        <i3dMapping id="attachable" node="0>0|0|0" />
        <i3dMapping id="attacherJoint" node="0>0|0|0|0" />
        <i3dMapping id="topReferenceNode" node="0>0|0|0|1" />
        <i3dMapping id="collisions" node="0>0|1" />
        <i3dMapping id="colPart1" node="0>0|1|0" />
        <i3dMapping id="colPart2" node="0>0|1|1" />		
        <i3dMapping id="levelerNode01" node="0>0|2" />		
        <i3dMapping id="levelerNode02" node="0>0|3" />	
        <i3dMapping id="levelerNode03" node="0>0|4" />		
        <i3dMapping id="effects" node="0>0|5" />
        <i3dMapping id="snowEffectNodeL" node="0>0|5|0" />			
        <i3dMapping id="snowEffectNodeR" node="0>0|5|1" />		
        <i3dMapping id="effectMeshL" 	node="0>0|5|2" />			
        <i3dMapping id="effectMeshR" 	node="0>0|5|3" />		
		<i3dMapping id="design1" node="0>0|6|0" />
		<i3dMapping id="design2" node="0>0|6|1" />		
		<i3dMapping id="design3" node="0>0|6|2" />		
		<i3dMapping id="design4" node="0>0|6|3" />			
    </i3dMappings>
</vehicle>
