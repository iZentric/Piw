<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<vehicle type="autoCoupling" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/vehicle.xsd">
    <annotation>Copyright (C) GIANTS Software GmbH, All Rights Reserved.</annotation>
    <storeData>
        <name>
			<en>Coupling with a bracket</en>
			<ru>Автосцепка с прицепной скобой</ru>			
        </name>
        <functions>
            <function>$l10n_function_weight</function>
        </functions>
    <specs>
      <combination xmlFilename="dt75_SMD_PD.xml"/>
      <combination xmlFilename="dt75_SMD_starter.xml"/>	  
    </specs>		
        <rotation>0</rotation>
        <image>store/store_Coupling.png</image>
        <price>800</price>
        <lifetime>600</lifetime>
        <brand>VgTZ</brand>
        <category>misc</category>
        <shopTranslationOffset>0 0 0</shopTranslationOffset>
        <shopRotationOffset>0 0 0</shopRotationOffset>
        <vertexBufferMemoryUsage>30976</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>10496</indexBufferMemoryUsage>
        <textureMemoryUsage>327680</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>
    <base>
        <typeDesc>$l10n_typeDesc_weight</typeDesc>
        <filename>dt75autoCoupling.i3d</filename>
        <size width="1" length="0.65" height="0.85"/>
        <components>
            <component centerOfMass="0 0.1 0" solverIterationCount="20" mass="250"/>
        </components>
        <schemaOverlay attacherJointPosition="0 0" name="IMPLEMENT"/>
        <mapHotspot type="TOOL"/>
    </base>

    <attachable>
        <inputAttacherJoints>
            <inputAttacherJoint node="attacherJoint" topReferenceNode="topReferenceNode" jointType="implement" isControllable="true" lowerTransLimitScale="0 0 0" lowerRotLimitScale="0 0 0" upperRotLimitScale="0 0 0" upperRotationOffset="0" lowerRotationOffset="0">
                <distanceToGround lower="0.3" upper="1.3"/>
                <bottomArm categories="2" ballType="1" ballDefaultVisibility="false"/>
            </inputAttacherJoint>
        </inputAttacherJoints>
        <!-- <support animationName="moveSupport"/> -->
    </attachable>

    <attacherJointControl>
        <control controlFunction="controlAttacherJointHeight" controlAxis="AXIS_FRONTLOADER_ARM2" invertControlAxis="false" mouseSpeedFactor="0.1" iconName="IMPLEMENT_ATTACHER_TRANS"/>
        <sounds>
            <hydraulic template="hydraulicClose01" linkNode="0>" pitchScale="0.6" volumeScale="2.5" fadeIn="0.1" fadeOut="0.1"/>
        </sounds>
    </attacherJointControl>

    <attacherJoints>
        <attacherJoint node="trailerAttacherJoint" jointType="trailer" lowerRotLimit="25 72 65" upperRotationOffset="0" allowsJointLimitMovement="false">
            <schema position="1 0" rotation="0" invertX="false"/>
        </attacherJoint>
        <attacherJoint node="trailerAttacherJointLow" jointType="trailerLow" lowerRotLimit="25 72 65" upperRotationOffset="0" allowsJointLimitMovement="false">
            <schema position="1 0" rotation="0" invertX="false"/>
        </attacherJoint>		
        <sounds>
            <attach template="attach01" linkNode="dt75coupling_main_component1"/>
        </sounds>
    </attacherJoints>
	

	<ai>
        <agentAttachment useSize="true"/>
    </ai>
	
	
    <tensionBeltObject>
        <meshNodes>
            <meshNode node="tensionBeltMesh01"/>
        </meshNodes>
    </tensionBeltObject>

    <connectionHoses>
        <hose inputAttacherJointIndices="1" type="hydraulicIn" node="hydraulicIn01" length="1.25" diameter="0.025" straighteningFactor="1.5">
           <objectChange node="hydraulicIn01" visibilityActive="true" visibilityInactive="false"/>
        </hose>
        <hose inputAttacherJointIndices="1" type="hydraulicOut" node="hydraulicOut01"  length="1.25" diameter="0.025" straighteningFactor="1.5">
           <objectChange node="hydraulicOut01" visibilityActive="true" visibilityInactive="false"/>
        </hose>

        <target attacherJointIndices="1" type="hydraulicIn" 	node="hydraulicIn01" 	socket="hydraulic01">
           <objectChange node="hydraulicIn01" visibilityActive="true" visibilityInactive="false"/>		
		</target>		
        <target attacherJointIndices="1" type="hydraulicOut" 	node="hydraulicOut01" 	socket="hydraulic01">
           <objectChange node="hydraulicOut01" visibilityActive="true" visibilityInactive="false"/>		
		</target>		
		
         <sounds>
            <connect    type="hydraulicIn"  template="generalConnection" volumeScale="1" pitchScale="1" linkNode="attacherJoint"/>
            <disconnect type="hydraulicIn"  template="generalConnection" volumeScale="1" pitchScale="1" linkNode="attacherJoint"/>
        </sounds>		
		
    </connectionHoses>

	
    <designColorConfigurations useDefaultColors="true" price="0">
        <material materialSlotName="frameColor" materialTemplateUseColorOnly="true"/>
		<designColorConfiguration color="0.7 0.1 0.05" />
		<designColorConfiguration color="0.462 0.060 0.028" isDefault="true"/>		
    </designColorConfigurations>
	
    <foliageBending>
        <bendingNode minX="-0.01" maxX="0.01" minZ="-0.01" maxZ="0.01" yOffset="0.01"/>
    </foliageBending>
    <wearable wearDuration="480" workMultiplier="5" fieldMultiplier="2" showOnHud="false"/>
    <washable dirtDuration="90" workMultiplier="2" fieldMultiplier="2" washDuration="1"/>
    <i3dMappings>
        <i3dMapping id="dt75coupling_main_component1" node="0>"/>
        <i3dMapping id="couplingVis" node="0>0"/>		
        <i3dMapping id="attacherJoint" node="0>0|0|0"/>
        <i3dMapping id="topReferenceNode" node="0>0|0|1"/>
        <i3dMapping id="trailerAttacherJoint" node="0>0|0|2"/>
        <i3dMapping id="trailerAttacherJointLow" node="0>0|0|3"/>		
        <i3dMapping id="tensionBeltMesh01" node="0>0|1|0"/>
        <i3dMapping id="collision" node="0>0|1|1"/>		
		
		<i3dMapping id="hydraulicIn01" node="0>0|2|0"/>
        <i3dMapping id="hydraulicIn01_connector" node="0>0|2|0|0"/>
        <i3dMapping id="hydraulicOut01" node="0>0|2|1"/>
        <i3dMapping id="hydraulicOut01_connector" node="0>0|2|1|0"/>			
    </i3dMappings>
</vehicle>
